      <table>
        <view>
          <datasources>
            <datasource caption='tableau_analysis_order_items' name='federated.056uakg0urgz9v12jyz9b0azap5j' />
          </datasources>
          <datasource-dependencies datasource='federated.056uakg0urgz9v12jyz9b0azap5j'>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Item Sales' datatype='real' name='[item_price]' role='measure' type='quantitative' />
